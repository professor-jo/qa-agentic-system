OPENAI_API_KEY=sk-...
# OpenAI model for the agents. gpt-5.4-mini: fast and affordable (default); gpt-6.1-sol: stronger, ~2-3x the cost; gpt-6-luna: cheapest.
MODEL=gpt-5.4-mini

# Optional. Leave unset for gpt-5*/o-series models, which only accept the default.
# TEMPERATURE=0.2

# Optional: how hard the model thinks. low = faster/cheaper, high = more thorough.
# Leave unset for the model's default. Values: low | medium | high | xhigh
# REASONING_EFFORT=low
